---
// 合作共赢页：加入我们 / 合作伙伴 / 联系我们 + 预约参观表单
import MainLayout from '@/layouts/MainLayout.astro';
import VisitForm from '@components/sections/home/VisitForm.astro';

const blocks = [
  {
    title: '加入我们',
    desc: '与卓越大健康一起，做有温度的医养事业。【待补充：招聘网站链接】',
    btn: '查看在招岗位',
    url: '#',
  },
  {
    title: '合作伙伴',
    desc: '医养联合体、社区共建、公益合作，期待与您携手。【待补充：合作洽谈联系方式】',
    btn: '洽谈合作',
    url: '#',
  },
  {
    title: '媒体与政企',
    desc: '新闻媒体、政企单位参访交流，欢迎扫码关注公众号与我们联系。',
    btn: '关注公众号',
    url: '#gzh',
  },
];
---

<MainLayout title="合作共赢｜卓越大健康">
  <section class="mx-auto max-w-[85rem] px-4 py-14 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-3xl text-center">
      <p class="text-sm font-bold tracking-widest text-orange-500">合作共赢</p>
      <h1 class="mt-2 text-3xl font-bold text-neutral-800 md:text-4xl">
        与卓越大健康同行
      </h1>
    </div>

    <div class="mt-12 grid gap-6 md:grid-cols-3">
      {
        blocks.map(b => (
          <div class="flex flex-col rounded-2xl bg-white p-7 shadow-sm ring-1 ring-neutral-200/60">
            <h2 class="text-xl font-bold text-neutral-800">{b.title}</h2>
            <p class="mt-3 grow text-sm leading-relaxed text-neutral-600">{b.desc}</p>
            <a
              href={b.url}
              class="mt-5 inline-flex w-fit items-center gap-2 rounded-full bg-orange-500 px-5 py-2.5 text-sm font-bold text-white transition hover:bg-orange-600"
            >
              {b.btn} <span aria-hidden="true">→</span>
            </a>
          </div>
        ))
      }
    </div>

    {/* 联系我们 */}
    <div id="gzh" class="mt-14 grid gap-8 rounded-2xl bg-white p-8 shadow-sm ring-1 ring-neutral-200/60 lg:grid-cols-2">
      <div>
        <h2 class="text-2xl font-bold text-neutral-800">联系我们</h2>
        <ul class="mt-5 space-y-3 text-sm text-neutral-600">
          <li><span class="font-bold text-neutral-800">咨询热线：</span>【待补充电话】</li>
          <li><span class="font-bold text-neutral-800">宽逸颐养院：</span>广州市海珠区前进路【详细地址待补充】</li>
          <li><span class="font-bold text-neutral-800">英明老人疗养院：</span>广州市荔湾区【详细地址待补充】</li>
          <li><span class="font-bold text-neutral-800">桃花源颐养院：</span>广州市白云区【详细地址待补充】</li>
          <li><span class="font-bold text-neutral-800">小港中医医院：</span>广州市海珠区（与宽逸颐养院同址）</li>
        </ul>
        {/* 地图占位 */}
        <div class="mt-6 flex h-48 items-center justify-center rounded-xl bg-neutral-100 text-sm text-neutral-400">
          【待嵌入地图：上线前接入高德/腾讯地图，需申请 Key】
        </div>
      </div>
      <div class="flex items-center justify-center gap-8">
        <figure class="text-center">
          <img src="/images/qr-gzh.jpg" alt="微信公众号二维码" class="h-40 w-40 rounded-xl ring-1 ring-neutral-200" />
          <figcaption class="mt-3 text-sm text-neutral-600">微信公众号</figcaption>
        </figure>
        <figure class="text-center">
          <img src="/images/qr-sph.jpg" alt="微信视频号二维码" class="h-40 w-40 rounded-xl ring-1 ring-neutral-200" />
          <figcaption class="mt-3 text-sm text-neutral-600">微信视频号</figcaption>
        </figure>
      </div>
    </div>
  </section>

  {/* 预约参观表单（锚点 #yuyue） */}
  <VisitForm />
</MainLayout>
