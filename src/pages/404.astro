---
// 404 页面（中文版）
import MainLayout from '@/layouts/MainLayout.astro';
import Btn404 from '@components/ui/buttons/Btn404.astro';
import { SITE } from '@data/constants';

const pageTitle = `页面未找到 | ${SITE.title}`;
---

<MainLayout title={pageTitle} hideFooter>
  <section class="min-h-[calc(100svh-5.5rem)]" aria-labelledby="subtitle">
    <div
      class="pointer-events-none fixed inset-0 z-10 grid place-content-center px-4"
    >
      <div
        class="pointer-events-auto mx-auto max-w-(--breakpoint-sm) text-center"
      >
        <h1 class="text-dark mb-4 text-7xl font-extrabold text-orange-500 lg:text-9xl">
          404
        </h1>
        <p
          id="subtitle"
          class="mb-4 text-3xl font-bold tracking-tight text-balance text-neutral-700 md:text-4xl"
        >
          抱歉，您访问的页面不存在
        </p>
        <p id="content" class="mb-4 text-lg text-pretty text-neutral-600">
          页面可能已被移除或地址有误，返回首页继续了解卓越大健康。
        </p>
        <div class="flex flex-wrap items-center justify-center gap-3">
          <a
            href="/"
            class="group inline-flex items-center justify-center gap-x-2 rounded-lg border border-transparent bg-orange-500 px-4 py-3 text-sm font-bold text-white transition duration-300 hover:bg-orange-600 2xl:text-base"
          >
            返回首页
          </a>
          <Btn404 title="返回上一页" id="go-back" />
        </div>
      </div>
    </div>
  </section>
</MainLayout>

<script>
  const goBackButton = document.getElementById('go-back');
  goBackButton?.addEventListener('click', () => {
    if (window.history.length > 1) {
      history.back();
    } else {
      window.location.href = '/';
    }
  });
</script>
