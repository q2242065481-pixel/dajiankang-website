---
// 右侧悬浮工具栏：电话咨询 / 公众号 / 回到顶部（对齐泰康之家）
---

<div
  class="fixed right-3 bottom-24 z-40 flex flex-col gap-1 rounded-2xl bg-white p-2 shadow-lg ring-1 ring-neutral-200 md:right-5"
>
  {/* 电话咨询 */}
  <button
    type="button"
    class="group flex h-11 w-11 items-center justify-center rounded-xl text-orange-500 transition hover:bg-orange-50"
    aria-label="电话咨询"
    title="咨询热线【待补充电话】"
    data-hs-overlay="#float-phone-tip"
  >
    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
    </svg>
  </button>
  {/* 微信公众号（悬停展示二维码） */}
  <div class="group relative">
    <button
      type="button"
      class="flex h-11 w-11 items-center justify-center rounded-xl text-orange-500 transition hover:bg-orange-50"
      aria-label="关注公众号"
      title="扫码关注公众号"
    >
      <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <rect x="3" y="3" width="7" height="7" rx="1"></rect>
        <rect x="14" y="3" width="7" height="7" rx="1"></rect>
        <rect x="3" y="14" width="7" height="7" rx="1"></rect>
        <path d="M14 14h3v3h-3zM21 14v3M17 21h4M14 20v1"></path>
      </svg>
    </button>
    <div
      class="pointer-events-none absolute top-1/2 right-full mr-3 hidden -translate-y-1/2 rounded-xl bg-white p-2 shadow-lg ring-1 ring-neutral-200 group-hover:block"
    >
      <img src="/images/qr-gzh.jpg" alt="微信公众号二维码" class="h-28 w-28 rounded-lg" />
    </div>
  </div>
  {/* 回到顶部 */}
  <button
    type="button"
    id="float-back-top"
    class="flex h-11 w-11 items-center justify-center rounded-xl text-orange-500 transition hover:bg-orange-50"
    aria-label="回到顶部"
    title="回到顶部"
  >
    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="m18 15-6-6-6 6"></path>
    </svg>
  </button>
</div>

<script>
  document
    .getElementById('float-back-top')
    ?.addEventListener('click', () =>
      window.scrollTo({ top: 0, behavior: 'smooth' })
    );
</script>
