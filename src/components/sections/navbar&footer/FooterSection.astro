---
// 卓越大健康官网页脚：橙色整版（对齐泰康之家页脚结构）
import strings from '@utils/navigation.ts';
---

<footer class="w-full bg-orange-500 text-white">
  <div
    class="mx-auto w-full max-w-[85rem] px-4 py-12 sm:px-6 lg:px-16 2xl:max-w-(--breakpoint-2xl)"
  >
    <div class="grid grid-cols-2 gap-8 md:grid-cols-4 lg:grid-cols-5">
      {/* 品牌列 */}
      <div class="col-span-full lg:col-span-1">
        <img src="/images/logo.png" alt="卓越教育｜卓越大健康" class="h-12 w-auto rounded-lg bg-white p-1.5" />
        <p class="mt-4 text-sm leading-relaxed text-orange-50">
          卓越教育旗下卓越大健康<br />广州医养结合
        </p>
        <p class="mt-3 text-sm text-orange-50">
          咨询热线：<span class="text-lg font-bold text-white">【待补充电话】</span>
        </p>
      </div>
      {/* 站点地图 */}
      {
        strings.footerLinks.map(section => (
          <div class="col-span-1">
            <h3 class="font-bold text-white">{section.section}</h3>
            <ul class="mt-4 grid space-y-3 text-sm">
              {section.links.map(link => (
                <li>
                  <a
                    href={link.url}
                    class="text-orange-50 transition hover:text-white"
                  >
                    {link.name}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
      {/* 联系地址 */}
      <div class="col-span-1">
        <h3 class="font-bold text-white">联系我们</h3>
        <ul class="mt-4 grid space-y-3 text-sm text-orange-50">
          <li>宽逸颐养院：广州市海珠区前进路【详细地址待补充】</li>
          <li>英明老人疗养院：广州市荔湾区【详细地址待补充】</li>
          <li>桃花源颐养院：广州市白云区【详细地址待补充】</li>
          <li>小港中医医院：广州市海珠区【详细地址待补充】</li>
        </ul>
      </div>
      {/* 二维码 */}
      <div class="col-span-1">
        <h3 class="font-bold text-white">关注我们</h3>
        <div class="mt-4 flex gap-4">
          <figure class="text-center">
            <img src="/images/qr-gzh.jpg" alt="微信公众号二维码" class="h-24 w-24 rounded-lg bg-white p-1" />
            <figcaption class="mt-2 text-xs text-orange-50">微信公众号</figcaption>
          </figure>
          <figure class="text-center">
            <img src="/images/qr-sph.jpg" alt="微信视频号二维码" class="h-24 w-24 rounded-lg bg-white p-1" />
            <figcaption class="mt-2 text-xs text-orange-50">微信视频号</figcaption>
          </figure>
        </div>
      </div>
    </div>
  </div>
  {/* 底部备案条 */}
  <div class="border-t border-orange-400/60">
    <div
      class="mx-auto flex w-full max-w-[85rem] flex-col items-center gap-2 px-4 py-5 text-center text-xs text-orange-100 sm:flex-row sm:justify-between sm:px-6 lg:px-16 2xl:max-w-(--breakpoint-2xl)"
    >
      <p>© 2026 卓越大健康 版权所有｜卓越教育旗下卓越大健康 · 广州医养结合</p>
      <p>
        <a href="#" class="hover:text-white">隐私政策</a>
        <span class="mx-2">|</span>
        <span>粤ICP备【待备案】号</span>
        <span class="mx-2">|</span>
        <span>粤公网安备【待备案】号</span>
      </p>
    </div>
  </div>
</footer>
