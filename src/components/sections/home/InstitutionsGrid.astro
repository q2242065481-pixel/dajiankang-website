---
// 5 机构卡片网格（对齐泰康之家板块8「讲居民故事」三列图片卡 + 业务板块入口）
import { institutions } from '@data/site_content';
---

<section class="bg-white py-14 md:py-20">
  <div class="mx-auto max-w-[85rem] px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-3xl text-center">
      <p class="text-sm font-bold tracking-widest text-orange-500">业务板块</p>
      <h2 class="mt-2 text-2xl font-bold text-neutral-800 md:text-4xl">
        三家颐养院 · 一家中医医院 · 一所老年大学
      </h2>
      <p class="mt-4 text-neutral-600">
        预算有限选桃花源，担心医疗选英明，追求品质选宽逸——总有一家适合您家。
      </p>
    </div>
    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        institutions.map(inst => (
          <a
            href={`/jigou#${inst.id}`}
            class="group relative block overflow-hidden rounded-2xl shadow-sm ring-1 ring-neutral-200/60 transition hover:-translate-y-1 hover:shadow-lg"
          >
            <img
              src={inst.image}
              alt={inst.imageAlt}
              class="h-64 w-full object-cover transition duration-500 group-hover:scale-105"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/75 via-black/20 to-transparent" />
            <div class="absolute right-5 bottom-5 left-5">
              <h3 class="text-xl font-bold text-white">{inst.name}</h3>
              <p class="mt-1 text-sm text-white/85">{inst.tagline}</p>
              {inst.bound && (
                <p class="mt-2 inline-block rounded-full bg-orange-500/90 px-3 py-1 text-xs font-bold text-white">
                  {inst.id === 'kuanyi' ? '与小港中医医院同址一体' : '与宽逸颐养院同址一体'}
                </p>
              )}
            </div>
          </a>
        ))
      }
      {/* 预约参观 CTA 卡（补足网格） */}
      <a
        href="/contact#yuyue"
        class="group flex flex-col items-center justify-center rounded-2xl bg-orange-500 p-8 text-center text-white transition hover:-translate-y-1 hover:bg-orange-600 hover:shadow-lg"
      >
        <p class="text-2xl font-bold">想实地看看？</p>
        <p class="mt-2 text-sm text-orange-100">
          留下联系方式，我们为您安排参观
        </p>
        <span class="mt-5 inline-flex items-center gap-2 rounded-full bg-white px-6 py-2.5 text-sm font-bold text-orange-600 transition group-hover:gap-3">
          预约参观 <span aria-hidden="true">→</span>
        </span>
      </a>
    </div>
  </div>
</section>
